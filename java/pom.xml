<?xml version="1.0" encoding="UTF-8"?>
<!-- Only used to fetch pinned jars:  mvn -q -f java/pom.xml dependency:copy-dependencies -DoutputDirectory=lib -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>sa.icore.pqc</groupId>
  <artifactId>pqc-shared-key-harness-deps</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <properties>
    <bc.version>1.81</bc.version>             <!-- 1.79+ required for plain FIPS 204 ML-DSA -->
    <jcstress.version>0.16</jcstress.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjdk.jcstress</groupId>
      <artifactId>jcstress-core</artifactId>
      <version>${jcstress.version}</version>
    </dependency>
  </dependencies>
</project>
